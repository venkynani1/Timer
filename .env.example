# ── Supabase (Project Settings → API) ─────────────────────────────────────────
# Only the public anon key is used. The service-role key is NEVER needed by this
# app — do not add it to Vercel or to any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Event ─────────────────────────────────────────────────────────────────────
# Slug of the row in public.events this deployment shows by default.
NEXT_PUBLIC_EVENT_SLUG=designathon-x
# IANA time zone for displayed wall-clock times (finish time, schedule). Defaults to the viewer's.
NEXT_PUBLIC_EVENT_TIMEZONE=Asia/Kolkata

# ── Developer simulation (?sim=…) ─────────────────────────────────────────────
# Always available in `npm run dev`. Disabled in production builds unless set
# to "true" (use only on a staging deployment). It never touches the real clock.
NEXT_PUBLIC_ALLOW_SIMULATION=false
